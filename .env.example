# ─────────────────────────────────────────────────────────────
# imbrace-fe — environment template.
# Copy to `.env.local` and fill in for your setup:
#   cp .env.example .env.local
# Hosts below default to localhost; point them at your running
# backend services (or a shared gateway). Secrets are left blank.
# ─────────────────────────────────────────────────────────────

# App runtime
VITE_APP_ENV="dev"                      # dev | staging | prod
VITE_APP_HOST="http://localhost:3001"   # this webapp's own URL (must match the dev port)
VITE_IS_MULTI_TENANCY=true              # true = multiple orgs; false = single "default" org

# ── Backend ──────────────────────────────────────────────────
# Main API gateway — routes platform / channel-service / data-board /
# ai / marketplace. Almost every /api call goes here.
VITE_APP_API_HOST="http://localhost:9001"
VITE_APP_API_HOST_OLD="http://localhost:9001"     # legacy API + websocket (/ws)

# Per-service hosts (most are routed by the gateway; override if you run them standalone)
VITE_APP_AI_HOST="http://localhost:7100"                  # AI service (/api/imbrace-ai)
VITE_APP_WCS_HOST="http://localhost:9001"                 # WCS / marketplace iframe
VITE_APP_INTERNAL_AI_CHAT_HOST="http://localhost:3000"    # embedded AI chat (imbrace-ai-chatbot)
VITE_APP_API_DATA_ANALYTICS_HOST="http://localhost:8000"  # analytics (InsightsIQ)
VITE_APP_API_IPS_HOST="http://localhost:6006"             # IPS / workflow service
VITE_APP_APWF_HOST="https://apwf.dev.imbrace.co"          # ActivePieces workflow host (proxied as /ap-workflow)
VITE_APP_BEST_ACTION="http://localhost:8500"              # next-best-action / ai-tracing
VITE_APP_DEV_PORTAL="http://localhost:4000"               # developer portal

# Chat widget (imbrace-chat-widget)
VITE_APP_CHAT_HOST="http://localhost:5000"
VITE_APP_API_CHAT_HOST="http://localhost:5000/chat.js"    # embeddable widget script

# Workflow / automation (ap-workflow)
VITE_APP_ACTIVEPIECES_DOMAIN="http://localhost:5678"
VITE_APP_CAMPAIGN_DOMAIN="http://localhost:4000"          # QR-code campaign page

# ── Third-party app IDs (use your own; leave blank to disable the feature) ──
VITE_APP_WHATSAPP_CONFIG_ID=""
VITE_APP_FACEBOOK_APP_ID=""
VITE_APP_FACEBOOK_CONFIG_ID=""
VITE_APP_INSTAGRAM_APP_ID=""
VITE_APP_PUSHY_APP_ID=""               # Pushy push-notification app ID
VITE_APP_GOOGLE_SCRIPT_URL=""          # Google Apps Script endpoint (optional)

# ── Analytics / monitoring (all optional — leave blank to disable) ──
VITE_APP_SENTRY_DSN=""                 # Sentry DSN; blank disables Sentry entirely
VITE_APP_SENTRY_ENV=""
VITE_APP_CLARITY_ID=""
